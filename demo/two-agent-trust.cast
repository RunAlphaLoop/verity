[0.051, "o", "\u001b[1;36m\r\n══ Verity — two-agent trust demo ══\r\n\u001b[0m\r\n  The claim: an agent can recall only what its user is already allowed to\r\n  see — permissions INHERITED from group membership and enforced in the\r\n  index, never handed to the agent as a token, never left to the model.\r\n  Proven live, end to end, over the real MCP tool interface.\r\n\r\n"]
[1.437, "o", "  demo space: 019f8c6f-59d4-7df1-9f14-d7c2801d2b38\r\n\r\n"]
[0.019, "o", "\u001b[1m  directory:\u001b[0m all-staff ⊃ engineering ⊃ alice   (bob: not a member)\r\n"]
[0.032, "o", "\u001b[1m  shared:  \u001b[0m 'eng-roadmap' → group:all-staff@acme.example only\r\n\r\n"]
[1.105, "o", "\u001b[2m  two agents connect over MCP — each naming only WHO it is:\r\n\u001b[0m\r\n"]
[0.844, "o", "  alice's agent — mode=subject-resolved subject=user:alice@acme.example\r\n"]
[0.064, "o", "    \u001b[1;32m✓ SEES the roadmap\u001b[0m — resolved alice → engineering → all-staff\r\n\r\n"]
[1.234, "o", "  bob's agent (not a member):\r\n    \u001b[1;32m✓ DARK\u001b[0m on a normal query\r\n    \u001b[1;32m✓ DARK\u001b[0m under a prompt-injection attempt\r\n\r\n"]
[1.205, "o", "\u001b[1;32m  PASS — the boundary held\r\n\u001b[0m\r\n"]
[0.043, "o", "\u001b[2m  (demo space torn down)\u001b[0m\r\n"]
