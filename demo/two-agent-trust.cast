[0.000, "o", "\u001b[31D\u001b[7mp\u001b[7my\u001b[7mt\u001b[7mh\u001b[7mo\u001b[7mn\u001b[7m3\u001b[7m \u001b[7md\u001b[7me\u001b[7mm\u001b[7mo\u001b[7m/\u001b[7mt\u001b[7mw\u001b[7mo\u001b[7m_\u001b[7ma\u001b[7mg\u001b[7me\u001b[7mn\u001b[7mt\u001b[7m_\u001b[7mt\u001b[7mr\u001b[7mu\u001b[7ms\u001b[7mt\u001b[7m.\u001b[7mp\u001b[7my\u001b[27m"]
[0.580, "o", "\u001b[31D\u001b[27mp\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mo\u001b[27mn\u001b[27m3\u001b[27m \u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m/\u001b[27mt\u001b[27mw\u001b[27mo\u001b[27m_\u001b[27ma\u001b[27mg\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m_\u001b[27mt\u001b[27mr\u001b[27mu\u001b[27ms\u001b[27mt\u001b[27m.\u001b[27mp\u001b[27my"]
